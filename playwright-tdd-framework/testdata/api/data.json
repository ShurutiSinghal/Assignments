{
     "duplicateRepo":{
        "requestType":"POST",
        "endpoint":"/user/repos",
        "body":{            
            "name" : "JMeterRepo"
        },
        "expectedStatusCode":422,
        "expectedStatusMessage":"Unprocessable Entity",
        "expErrorMessage":"Repository creation failed."
     },
     "validRepo":{
        "requestType":"POST",
        "endpoint":"/user/repos",
        "body":{            
            "name" : "JMeterRepoNew"
        },
        "expectedStatusCode":201,
        "expectedStatusMessage":"Created",
        "name":"JMeterRepoNew"
     },
     "getRepo":{
        "requestType":"GET",
        "endpoint":"/repos/Shuruti1234/JMeterRepoNew",
        "expectedStatusCode":200,
        "expectedStatusMessage":"OK",
        "name":"JMeterRepoNew"
     },
      "updateRepo":{
        "requestType":"PATCH",
        "endpoint":"/repos/Shuruti1234/JMeterRepoNew",
        "body":{            
            "name" : "JMeterRepoNewUpdated"
        },
        "expectedStatusCode":200,
        "expectedStatusMessage":"OK",
        "name":"JMeterRepoNewUpdated"
     },
      "deleteRepo":{
        "requestType":"DELETE",
        "endpoint":"/repos/Shuruti1234/JMeterRepoNewUpdated",
        "expectedStatusCode":204,
        "expectedStatusMessage":"No Content"       
     }
}